msgstr "Messaggio inviato"

#: LIB/src/omega_lib/interfaces/tui/contact_support.py:348
#, python-brace-format
msgid "Destination : {RECEPTION_URL}"
msgstr "Destinazione: {RECEPTION_URL}"

#: LIB/src/omega_lib/interfaces/tui/contact_support.py:349
msgid "Jamais envoyés : votre nom, le nom de la machine, vos réglages, vos cibles ni vos résultats."
msgstr "Mai inviati: il suo nome, il nome della macchina, le sue impostazioni, i suoi obiettivi né i suoi risultati."

#: LIB/src/omega_lib/interfaces/tui/contact_support.py:351
msgid "Votre adresse IP n'est pas enregistrée dans les déclarations. Comme pour toute visite d'un site, elle passe par les contrôles de sécurité et le journal technique du serveur de réception."
msgstr "Il vostro indirizzo IP non viene registrato nelle dichiarazioni. Come per qualsiasi visita a un sito, passa attraverso i controlli di sicurezza e il log tecnico del server di ricezione."

#: LIB/src/omega_lib/interfaces/tui/contact_support.py:354
msgid "Vous pouvez retirer votre déclaration à tout moment depuis Contact et support."
msgstr "Potete ritirare la vostra dichiarazione in qualsiasi momento da Contatti e supporto."

