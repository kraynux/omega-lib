msgid "Vous n'êtes plus déclaré : votre entrée est supprimée et la clé effacée."
msgstr "Non siete più dichiarati: la vostra voce è stata eliminata e la chiave cancellata."

#: LIB/src/omega_lib/interfaces/tui/contact_support.py:267
msgid "Clé effacée. Réception injoignable : votre entrée y disparaîtra seule (1 an)."
msgstr "Chiave cancellata. Ricezione irraggiungibile: la sua voce lì scomparirà da sola (1 anno)."

